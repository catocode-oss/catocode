# Copy this file to .env for local development.
# .env is loaded automatically by python-dotenv at startup.
# In production (Zappa / AWS Lambda), set environment variables in
# zappa_settings.json under "environment_variables" or use
# "aws_environment_variables" to reference AWS Parameter Store / Secrets Manager.

# PostgreSQL connection URL.
# Leave unset to use the local projects.json fallback (no DB required).
# Format: postgresql://user:password@host:5432/dbname
# Example (Supabase, Neon, RDS, etc.):
#   DATABASE_URL=postgresql://catocode:s3cret@db.example.com:5432/catocode
DATABASE_URL=

# Flask secret key — change this before deploying.
CODE_SABOTAGE_SECRET=dev-secret-change-me
